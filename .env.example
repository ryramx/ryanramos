# Copie para .env.local e preencha. Na Vercel, cadastre em Settings > Environment Variables.

# Endereço público do site (usado em SEO, sitemap e imagens de compartilhamento).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulário de contato (https://resend.com/api-keys)
RESEND_API_KEY=
# Para onde as mensagens do formulário vão.
CONTACT_TO_EMAIL=
# Remetente verificado no Resend. Sem domínio próprio, use onboarding@resend.dev
# (nesse modo o Resend só entrega para o e-mail dono da conta).
CONTACT_FROM_EMAIL=Portfólio <onboarding@resend.dev>
